# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_from_@BotFather

# Google OAuth2 (from Google Cloud Console → APIs & Services → Credentials)
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret
# Required for calendar linking: HTTPS URL where Google redirects after sign-in.
# Add this exact URL to Google Console → Credentials → OAuth 2.0 Client → Authorized redirect URIs.
# Domain and SSL are managed by Dokploy/Traefik — just set the URL with your domain.
# OAUTH_REDIRECT_URI=https://your-domain.com/oauth/callback

# Voice → calendar: transcription + extraction via OpenRouter. https://openrouter.ai/
OPENROUTER_API_KEY=your_openrouter_api_key

# Admin Telegram user ID (for broadcast via voice). Get it from @userinfobot.
# ADMIN_TELEGRAM_ID=123456789

# Allowed user IDs (comma-separated). If set, only these users can use the bot.
# ALLOWED_USER_IDS=123456789,987654321

# PostgreSQL connection string for expense tracking
# DATABASE_URL=postgresql://bot:changeme@localhost:5432/expenses_bot

# Monthly expense limit in rubles (default: 350000)
# MONTHLY_EXPENSE_LIMIT=350000

# Default bot mode: "calendar", "expenses", or "transcribe" (default: calendar)
# DEFAULT_BOT_MODE=calendar

# Redis connection for voice transcription queue (enables /transcribe mode)
# REDIS_URL=redis://localhost:6379

# Docker:
# DB_PASSWORD=changeme

# HTTP server port (default: 18790). Dokploy/Traefik proxies HTTPS to this port.
# PORT=18790

# Mini App URL for Telegram menu button and addToHomeScreen().
# Set WEBAPP_URL to your public HTTPS domain (e.g. https://your-domain.com/).
# Without this, the "Add to Home Screen" button in Mini App will not work.
# WEBAPP_URL=https://your-domain.com/

# Log level: debug, info, warn, error (default: info)
# LOG_LEVEL=info

# Telegram Parser — MTProto user account for channel reading (enables /digest mode)
# Get api_id and api_hash from https://my.telegram.org/apps
# Use a DEDICATED phone number, not your primary Telegram account
# TELEGRAM_PARSER_API_ID=12345
# TELEGRAM_PARSER_API_HASH=abcdef1234567890abcdef1234567890

# Digest cron schedule (default: "0 6 * * *" = daily at 6:00 Moscow time)
# DIGEST_CRON=0 6 * * *

# Max total tracked channels across all users (default: 100)
# DIGEST_MAX_CHANNELS_TOTAL=100

# Proxy for Telegram API (if Telegram is blocked/throttled)
# Supports: socks5://host:port, socks5://user:pass@host:port, http://host:port
# TELEGRAM_PROXY=socks5://127.0.0.1:1080

# Proxy for OpenRouter / STT traffic (voice, DeepSeek, chat, digests).
# Use when the server IP is blocked by openrouter.ai. Same schemes as TELEGRAM_PROXY;
# falls back to TELEGRAM_PROXY if unset.
# OPENROUTER_PROXY=socks5h://user:pass@host:port

# Tavily API — включает /osint И веб-поиск в режиме «Нейро» (бот + Mini App).
# Без ключа поиск отключается (в UI показывается предупреждение), а чтение ссылок
# из сообщений продолжает работать. https://tavily.com/
# TAVILY_API_KEY=tvly-xxx

# Откуда «Нейро» берёт веб-поиск (по умолчанию auto):
#   auto       — модели Anthropic/OpenAI/Google/Perplexity/xAI ищут сами через
#                встроенный поиск OpenRouter (оплата по тарифу провайдера),
#                остальные — через Tavily с предварительным классификатором;
#   tavily     — всегда Tavily, встроенный поиск не используется;
#   openrouter — всегда плагин OpenRouter (для моделей без своего поиска это Exa,
#                ~$0.007 за КАЖДЫЙ запрос — включать осознанно);
#   off        — поиск выключен, модель честно предупреждает, что отвечает по памяти.
# Чтение ссылок из сообщений работает во всех режимах.
# NEURO_WEB_SEARCH=auto

# Вебхук-режим бота (по умолчанию long polling — эти переменные не заданы).
# TELEGRAM_WEBHOOK_SECRET ОБЯЗАТЕЛЕН при заданном домене: без него Telegraf
# принимает любой POST на путь вебхука, а значит кто угодно сможет присылать
# поддельные апдейты от имени любого пользователя. Бот откажется стартовать.
# Сгенерировать: openssl rand -hex 32
# TELEGRAM_WEBHOOK_DOMAIN=https://oauth.podbor-minuta.ru
# TELEGRAM_WEBHOOK_PATH=/telegram/webhook
# TELEGRAM_WEBHOOK_SECRET=

# OpenTelemetry — OTLP exporter endpoint (enables tracing when set)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=sovetnik-bot

# Neuro chat limits (optional; defaults 50 / 10). Change and redeploy to adjust.
# CHAT_MESSAGE_LIMIT=50   # max messages per dialog (= context window)
# CHAT_MAX_DIALOGS=10     # max active dialogs per user

# ── Claude Code bridge (мост сессий Claude Code в Telegram) ──────────────────
# Супергруппа с включёнными топиками; бот должен быть админом с правом
# "Управление темами". ID отрицательный, с префиксом -100.
CC_GROUP_ID=
# Общий секрет машин и хаба. Любой длинный случайный: openssl rand -hex 32
CC_MACHINE_TOKEN=
